---
// Page d'accueil du domaine : envoie vers /en/ si le navigateur est en anglais, sinon vers /fr/.
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nexus</title>
    <meta name="theme-color" content="#0E0B16" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="/fr/" />
    <meta http-equiv="refresh" content="0; url=/fr/" />
    <script is:inline>
      if (navigator.language && navigator.language.toLowerCase().startsWith('en')) {
        location.replace('/en/');
      }
    </script>
    <style>
      body {
        margin: 0;
        background: #0e0b16;
      }
    </style>
  </head>
  <body>
    <noscript><a href="/fr/">Nexus</a></noscript>
  </body>
</html>
