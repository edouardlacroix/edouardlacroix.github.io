---
import '@fontsource-variable/syne';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import { locales, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const other = locales.find((l) => l !== locale)!;
const urlOf = (l: Locale) => new URL(`/${l}/`, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#0E0B16" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={urlOf(locale)} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={urlOf(l)} />)}
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={urlOf(locale)} />
    <meta property="og:locale" content={locale} />
  </head>
  <body>
    <div class="page">
      <div class="watermark" aria-hidden="true">NEXUS</div>
      <slot />
      <footer class="foot">
        <span>© {new Date().getFullYear()} Édouard Lacroix</span>
        <a href={`/${other}/`} hreflang={other} lang={other}>{ui[locale].otherLanguage}</a>
      </footer>
    </div>
  </body>
</html>

<style>
  .page {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    overflow: hidden;
  }

  .watermark {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    text-align: center;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: min(24vw, 340px);
    line-height: 0.85;
    letter-spacing: 0.04em;
    pointer-events: none;
    user-select: none;
    background: linear-gradient(
      180deg,
      rgb(255 243 224 / 0.2) 0%,
      rgb(255 243 224 / 0.06) 65%,
      rgb(255 243 224 / 0) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-mask-image: radial-gradient(ellipse at center, #000 35%, transparent 80%);
    mask-image: radial-gradient(ellipse at center, #000 35%, transparent 80%);
    /* Arrive en fin de dessin du contour (2,6 s), petit puis il grossit en apparaissant. */
    animation: watermark-in 2.4s cubic-bezier(0.2, 0.6, 0.2, 1) 2.2s both;
  }

  @keyframes watermark-in {
    from {
      opacity: 0;
      transform: translateY(-50%) scale(0.82);
    }
    to {
      opacity: 1;
      transform: translateY(-50%) scale(1);
    }
  }

  .foot {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 14px;
    padding: 0 56px 20px;
    font-size: 12px;
    color: rgb(167 159 184 / 0.35);
  }

  .foot a {
    color: inherit;
    text-decoration: none;
  }

  .foot a:hover,
  .foot a:focus-visible {
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .foot {
      padding-inline: 16px;
    }
  }
</style>
