---
import { getCollection } from 'astro:content';
import Nexus from '../../components/Nexus.astro';
import NexusList from '../../components/NexusList.astro';
import { locales, type Locale } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import { bySlot } from '../../lib/tools';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const entries = await getCollection('tools');
const slots = bySlot(entries.map((entry) => ({ ...entry.data, id: entry.id })));
---

<Base locale={locale}>
  <main>
    <h1 class="sr-only">Nexus</h1>
    <Nexus slots={slots} locale={locale} />
    <NexusList slots={slots} locale={locale} />
  </main>
</Base>

<style>
  main {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>
